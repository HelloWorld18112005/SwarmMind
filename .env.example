APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-secret-key-32-chars-long
FRONTEND_ORIGIN=http://localhost:5173

# Graph backend: 'local' (offline development) or 'falkordb' (cloud/remote instance)
GRAPH_BACKEND=local

# FalkorDB Cloud credentials (used when GRAPH_BACKEND=falkordb)
FALKORDB_HOST=
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=true
FALKORDB_GRAPH=swarmmind

# LLM Provider configuration ('mock', 'gemini', 'openai')
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# Execution Limits
MAX_CONCURRENT_AGENTS=3
MAX_AGENT_STEPS=20
MAX_RUN_DURATION_SECONDS=600
